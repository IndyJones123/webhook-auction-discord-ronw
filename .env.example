# Discord Developer Portal > your application > General Information
DISCORD_APPLICATION_ID=your_application_id
DISCORD_PUBLIC_KEY=your_public_key
# Bot > Token (used to register slash commands)
DISCORD_BOT_TOKEN=your_bot_token
# Optional: server ID so commands show up instantly (empty = global)
DISCORD_GUILD_ID=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_auction
