# Discord Developer Portal > aplikasi kamu > General Information
DISCORD_APPLICATION_ID=isi_application_id
DISCORD_PUBLIC_KEY=isi_public_key
# Bot > Token (dipakai untuk mendaftarkan slash command)
DISCORD_BOT_TOKEN=isi_bot_token
# Opsional: ID server supaya command langsung muncul (kosongkan = global)
DISCORD_GUILD_ID=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_auction
